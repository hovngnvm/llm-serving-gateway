# Enterprise Hybrid Cloud AI Platform Configuration

# vLLM Local Inference Engine
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
HF_TOKEN=

# Redis Stack (Vector Semantic Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_SECONDS=86400

# FastAPI Security Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_API_KEY=your_secret_gateway_api_key_here

# Neon Serverless PostgreSQL Cloud (Audit Logs)
NEON_DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Grafana Cloud Observability (Optional Telemetry)
GRAFANA_CLOUD_REMOTE_WRITE_URL=https://prometheus-prod-01-eu-west-0.grafana.net/api/prom/push
GRAFANA_CLOUD_USER=
GRAFANA_CLOUD_API_KEY=
